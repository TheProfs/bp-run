{
  "name": "@theprofs/bp-run",
  "version": "1.0.0",
  "description": "CLI for Stripe and PostgreSQL operations",
  "type": "module",
  "bin": {
    "bp-run": "./dist/cli.js"
  },
  "exports": "./dist/cli.js",
  "files": [
    "dist/cli.js"
  ],
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "build": "tsc src/cli.ts --outDir dist --module nodenext --target esnext --moduleResolution nodenext --esModuleInterop --skipLibCheck --noCheck",
    "test": "NODE_ENV=test node --experimental-transform-types --test",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "stripe",
    "postgresql",
    "cli",
    "database",
    "sync"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TheProfs/bp-run.git"
  },
  "author": "TheProfs",
  "license": "MIT",
  "dependencies": {
    "pg": "^8.13.1",
    "stripe": "^17.4.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
